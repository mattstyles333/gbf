# Public Web3Forms access key for the /book/ enquiry form.
# Create a key at https://web3forms.com using GreatBonefishing@gmail.com
# (the key is emailed to that address). It is safe to expose in the browser;
# Next.js inlines NEXT_PUBLIC_* values at build time for the static export.
#
# Cloudflare Pages → project `gbf` → Settings → Environment variables
# → Production → add NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY, then redeploy.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
